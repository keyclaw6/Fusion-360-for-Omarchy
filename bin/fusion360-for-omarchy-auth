#!/usr/bin/env python3
from pathlib import Path
import os
import sys

sys.dont_write_bytecode = True
package = Path(__file__).resolve().parent.parent
if (package / "install-manifest.json").is_file():
    os.environ.setdefault("FUSION360_STATE", str(package))
sys.path.insert(0, str(package / "lib"))
from fusion360_omarchy import main

if len(sys.argv) != 2:
    raise SystemExit("Expected one Autodesk callback.")
raise SystemExit(main(["auth", "--", sys.argv[1]]))
