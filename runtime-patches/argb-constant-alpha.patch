@@ -0,0 +1,19 @@
+/*
+ * Constant-alpha GDI upload conversion.
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+#ifndef __WINE_X11DRV_CONSTANT_ALPHA_H
+#define __WINE_X11DRV_CONSTANT_ALPHA_H
+
+/* SetLayeredWindowAttributes ignores the source bitmap's reserved alpha byte.
+ * XWayland ARGB buffers require premultiplied color channels. */
+static inline unsigned int x11drv_premultiply_constant_alpha( unsigned int pixel, unsigned int alpha )
+{
+    unsigned int red = (((pixel >> 16) & 255) * alpha + 127) / 255;
+    unsigned int green = (((pixel >> 8) & 255) * alpha + 127) / 255;
+    unsigned int blue = ((pixel & 255) * alpha + 127) / 255;
+
+    return (alpha << 24) | (red << 16) | (green << 8) | blue;
+}
+
+#endif
