+/* Mesa X11 WSI enqueues presentation on a worker.  Copying an offscreen
+ * drawable immediately after QueuePresent therefore races the source update.
+ * Match the GLX offscreen path: wait for this submitted frame before copying.
+ * Use only features already enabled by the application and its existing ID.
+ * A single finite wait plus per-swapchain disablement bounds a broken WSI path.
+ */
+#define X11_PRESENT_WAIT_TIMEOUT_NS (1000 * 1000000ull)
+
+static void x11_wait_before_client_present( struct vulkan_device *device, struct swapchain *swapchain,
+                                            const VkPresentInfoKHR *info, uint32_t index, BOOL submitted, VkResult presented )
+{
+    const struct x11_present_device *x11_device = x11_present_device( device );
+    const VkPresentIdKHR *ids;
+    const VkPresentId2KHR *ids2;
+    uint64_t present_id = 0;
+    VkResult result;
+    BOOL use_wait2 = FALSE;
+    DWORD start;
+
+    if (!x11_device->enabled || !submitted || presented < VK_SUCCESS || swapchain->managed ||
+        swapchain->x11_present_wait_disabled || swapchain->x11_present_wait_retired ||
+        !swapchain->surface || !swapchain->surface->client ||
+        !InterlockedCompareExchange( &swapchain->surface->client->offscreen, 0, 0 ) ||
+        swapchain_is_out_of_date( swapchain )) return;
+
+    ids2 = find_next_struct( info->pNext, VK_STRUCTURE_TYPE_PRESENT_ID_2_KHR );
+    ids = find_next_struct( info->pNext, VK_STRUCTURE_TYPE_PRESENT_ID_KHR );
+    if (ids2 && index < ids2->swapchainCount && ids2->pPresentIds &&
+        x11_device->present_wait2 && device->extensions.has_VK_KHR_present_wait2 &&
+        device->p_vkWaitForPresent2KHR && swapchain->x11_present_wait2)
+    {
+        present_id = ids2->pPresentIds[index];
+        use_wait2 = TRUE;
+    }
+    else if (ids && index < ids->swapchainCount && ids->pPresentIds &&
+             x11_device->present_wait && device->extensions.has_VK_KHR_present_wait &&
+             device->p_vkWaitForPresentKHR)
+        present_id = ids->pPresentIds[index];
+
+    if (!present_id)
+    {
+        if (!swapchain->x11_present_wait_warned)
+        {
+            WARN_(x11present)( "hwnd %p swapchain %p: no usable submitted ID/enabled wait feature; original copy path retained "
+                               "(id %u id2 %u wait %u wait2 %u flag2 %u)\n",
+                               swapchain->surface->hwnd, swapchain, !!ids, !!ids2,
+                               x11_device->present_wait, x11_device->present_wait2, swapchain->x11_present_wait2 );
+            swapchain->x11_present_wait_warned = TRUE;
+        }
+        return;
+    }
+
+    start = NtGetTickCount();
+    if (use_wait2)
+    {
+        VkPresentWait2InfoKHR wait_info = {.sType = VK_STRUCTURE_TYPE_PRESENT_WAIT_2_INFO_KHR};
+        wait_info.presentId = present_id;
+        wait_info.timeout = X11_PRESENT_WAIT_TIMEOUT_NS;
+        result = device->p_vkWaitForPresent2KHR( device->host.device, swapchain->obj.host.swapchain, &wait_info );
+    }
+    else
+        result = device->p_vkWaitForPresentKHR( device->host.device, swapchain->obj.host.swapchain,
+                                               present_id, X11_PRESENT_WAIT_TIMEOUT_NS );
+
+    TRACE_(x11present)( "hwnd %p swapchain %p ID %s wait%u result %d elapsed %lu ms before client copy\n",
+                       swapchain->surface->hwnd, swapchain, wine_dbgstr_longlong( present_id ), use_wait2 ? 2 : 1,
+                       result, (unsigned long)(NtGetTickCount() - start) );
+    if (result != VK_SUCCESS && result != VK_SUBOPTIMAL_KHR)
+    {
+        WARN_(x11present)( "hwnd %p swapchain %p: presentation wait failed (%d); disabling waits for this swapchain\n",
+                           swapchain->surface->hwnd, swapchain, result );
+        swapchain->x11_present_wait_disabled = TRUE;
+    }
+}
