+/* Private allocation tail: the shared vulkan_device ABI remains unchanged. */
+struct x11_present_device
+{
+    struct vulkan_device obj;
+    BOOL enabled;
+    BOOL present_wait;
+    BOOL present_wait2;
+};
+
+static struct x11_present_device *x11_present_device( struct vulkan_device *device )
+{
+    return CONTAINING_RECORD( device, struct x11_present_device, obj );
+}
+
+static void init_x11_present_device( struct x11_present_device *device, const VkDeviceCreateInfo *info )
+{
+    const VkPhysicalDevicePresentWaitFeaturesKHR *wait;
+    const VkPhysicalDevicePresentWait2FeaturesKHR *wait2;
+    const char *env = getenv( "WINE_X11_VULKAN_PRESENT_WAIT" );
+
+    device->enabled = env && !strcmp( env, "1" );
+    if (!device->enabled) return;
+
+    wait = find_next_struct( info->pNext, VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PRESENT_WAIT_FEATURES_KHR );
+    wait2 = find_next_struct( info->pNext, VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PRESENT_WAIT_2_FEATURES_KHR );
+    device->present_wait = wait && wait->presentWait;
+    device->present_wait2 = wait2 && wait2->presentWait2;
+    TRACE_(x11present)( "device %p enabled features: presentWait %u, presentWait2 %u\n",
+                       &device->obj, device->present_wait, device->present_wait2 );
+}
