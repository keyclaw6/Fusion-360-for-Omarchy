+/***********************************************************************
+ *             NtMapUserPhysicalPagesScatter   (NTDLL.@)
+ *             ZwMapUserPhysicalPagesScatter   (NTDLL.@)
+ *
+ * AWE (Address Windowing Extensions) is not implemented in Wine: memory
+ * reserved with MEM_PHYSICAL is backed by ordinary RAM and stays mapped,
+ * so remapping physical pages into the window is a no-op here.  The point
+ * of this stub is to return gracefully instead of aborting the process,
+ * which is what the previous "@ stub" entry did on the first call.
+ */
+NTSTATUS WINAPI NtMapUserPhysicalPagesScatter( void **addresses, ULONG_PTR page_count, ULONG_PTR *pages )
+{
+    static int once;
+    if (!once++)
+        FIXME( "(%p %lu %p): no-op stub\n", addresses, page_count, pages );
+    return STATUS_SUCCESS;
+}
+
+
