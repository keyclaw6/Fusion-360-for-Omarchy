@@ -282,6 +282,20 @@ NTSTATUS WINAPI wow64_NtFlushInstructionCache( UINT *args )
 }
 
 
+/**********************************************************************
+ *           wow64_NtMapUserPhysicalPagesScatter
+ */
+NTSTATUS WINAPI wow64_NtMapUserPhysicalPagesScatter( UINT *args )
+{
+    void **addresses = get_ptr( &args );
+    ULONG_PTR page_count = get_ulong( &args );
+    ULONG_PTR *pages = get_ptr( &args );
+
+    /* AWE is a no-op under Wine (MEM_PHYSICAL is ordinary RAM); pointer layout is irrelevant. */
+    return NtMapUserPhysicalPagesScatter( addresses, page_count, pages );
+}
+
