ole32: Remove the drop target props before releasing the target.

RevokeDragDrop() releases the registered drop target before it removes the
window props that point at it.  Dropping the last reference runs application
code - the target's destructor - and applications commonly revoke from there,
which is what MFC- and ATL-style teardown does.  That reentrant call still
finds IsWindow() true, still finds both props in place, looks up the same
pointer and releases it a second time.

Autodesk Inventor hits this while tearing down a document window.

Remove the props first, so a revoke issued from the destructor takes the
DRAGDROP_E_NOTREGISTERED path instead.  The map handle is read before the
props are dropped, so the rest of the function is unaffected.

Without the fix the added test reports "DropTarget refs should be zero not -1",
which is the second release.
diff --git a/dlls/ole32/ole2.c b/dlls/ole32/ole2.c
index 36838628..dbfcd847 100644
--- a/dlls/ole32/ole2.c
+++ b/dlls/ole32/ole2.c
@@ -645,11 +645,16 @@ HRESULT WINAPI RevokeDragDrop(HWND hwnd)
     return DRAGDROP_E_NOTREGISTERED;
 
   drop_target = GetPropW(hwnd, prop_oledroptarget);
-  if(drop_target) IDropTarget_Release(drop_target);
 
   RemovePropW(hwnd, prop_oledroptarget);
   RemovePropW(hwnd, prop_marshalleddroptarget);
 
+  /* Release the target only once the props are gone.  Dropping the last
+   * reference runs the application's destructor, and some applications call
+   * RevokeDragDrop() from there; with the props still in place that reentrant
+   * call would look up the same pointer and release it a second time. */
+  if (drop_target) IDropTarget_Release(drop_target);
+
   hr = create_stream_from_map(map, &stream);
   if(SUCCEEDED(hr))
   {
diff --git a/dlls/ole32/tests/dragdrop.c b/dlls/ole32/tests/dragdrop.c
index 441b11a9..26d45597 100644
--- a/dlls/ole32/tests/dragdrop.c
+++ b/dlls/ole32/tests/dragdrop.c
@@ -348,6 +348,36 @@ static const IDropTargetVtbl DropTarget_VTbl =
     DropTarget_Drop
 };
 
+/* A drop target that revokes from its own destructor, which is what MFC- and
+ * ATL-style teardown does. */
+static HWND revoke_hwnd;
+static int revoke_reentered;
+
+static ULONG WINAPI RevokingDropTarget_Release(IDropTarget *iface)
+{
+    droptarget_refs--;
+    if (!droptarget_refs && revoke_hwnd)
+    {
+        HRESULT hr = RevokeDragDrop(revoke_hwnd);
+        ok(hr == DRAGDROP_E_NOTREGISTERED, "got %#lx\n", hr);
+        revoke_reentered++;
+    }
+    return droptarget_refs;
+}
+
+static const IDropTargetVtbl RevokingDropTarget_VTbl =
+{
+    DropTarget_QueryInterface,
+    DropTarget_AddRef,
+    RevokingDropTarget_Release,
+    DropTarget_DragEnter,
+    DropTarget_DragOver,
+    DropTarget_DragLeave,
+    DropTarget_Drop
+};
+
+static IDropTarget RevokingDropTarget = { &RevokingDropTarget_VTbl };
+
 static IDropTarget DropTarget = { &DropTarget_VTbl };
 
 static HRESULT WINAPI DropSource_QueryInterface(IDropSource *iface, REFIID riid, void **ppObj)
@@ -701,6 +731,40 @@ static void test_Register_Revoke(void)
     OleUninitialize();
 }
 
+/* Releasing the drop target runs application code, so RevokeDragDrop() has to
+ * remove the window props before it drops its reference.  Otherwise a revoke
+ * issued from the target's destructor finds the props still in place and
+ * releases the same object a second time. */
+static void test_Revoke_reentrancy(void)
+{
+    HRESULT hr;
+    HWND hwnd;
+
+    OleInitialize(NULL);
+
+    hwnd = CreateWindowA("WineOleTestClass", "Test", 0,
+        CW_USEDEFAULT, CW_USEDEFAULT, CW_USEDEFAULT, CW_USEDEFAULT, NULL,
+        NULL, NULL, NULL);
+    ok(hwnd != NULL, "failed to create window\n");
+
+    droptarget_refs = 0;
+    revoke_reentered = 0;
+    revoke_hwnd = hwnd;
+
+    hr = RegisterDragDrop(hwnd, &RevokingDropTarget);
+    ok_ole_success(hr, "RegisterDragDrop");
+    ok(droptarget_refs == 1, "DropTarget refs should be one not %d\n", droptarget_refs);
+
+    hr = RevokeDragDrop(hwnd);
+    ok_ole_success(hr, "RevokeDragDrop");
+    ok(revoke_reentered == 1, "expected a reentrant revoke, got %d\n", revoke_reentered);
+    ok(droptarget_refs == 0, "DropTarget refs should be zero not %d\n", droptarget_refs);
+
+    revoke_hwnd = NULL;
+    DestroyWindow(hwnd);
+    OleUninitialize();
+}
+
 static void test_DoDragDrop(void)
 {
     DWORD effect;
@@ -827,2 +891,3 @@ START_TEST(dragdrop)
     test_Register_Revoke();
+    test_Revoke_reentrancy();
     test_DoDragDrop();
