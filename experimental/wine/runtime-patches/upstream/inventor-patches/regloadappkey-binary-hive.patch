+static inline WORD  hive_u16( const BYTE *p ) { WORD v;  memcpy( &v, p, 2 ); return v; }
+static inline DWORD hive_u32( const BYTE *p ) { DWORD v; memcpy( &v, p, 4 ); return v; }
 
