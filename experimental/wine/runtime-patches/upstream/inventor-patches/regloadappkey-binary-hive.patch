-    return ERROR_SUCCESS;
+/* convert a hive key/value name (ASCII or UTF-16LE) into a NUL-terminated WCHAR */
+static WCHAR *hive_name( const BYTE *p, DWORD byte_len, BOOL is_ascii )
+{
+    WCHAR *out;
+    DWORD i, count;
+
+    count = is_ascii ? byte_len : byte_len / sizeof(WCHAR);
+    if (!(out = HeapAlloc( GetProcessHeap(), 0, (count + 1) * sizeof(WCHAR) ))) return NULL;
+    if (is_ascii) for (i = 0; i < count; i++) out[i] = (BYTE)p[i];
+    else          for (i = 0; i < count; i++) out[i] = hive_u16( p + i * 2 );
+    out[count] = 0;
+    return out;
+}
+
+/* fetch the data of a vk value, handling inline and "db" big-data records;
+ * caller frees *alloc if non-NULL */
+static const BYTE *hive_value_data( const struct hive_buf *h, DWORD data_len, DWORD data_off,
+                                    BYTE **alloc, DWORD *out_len )
+{
+    const BYTE *cell;
+    DWORD clen;
+
+    *alloc = NULL;
+    if (data_len & 0x80000000)   /* data stored inline in the offset field (LE dword) */
+    {
+        DWORD n = data_len & 0x7fffffff;
+        if (n > 4) n = 4;
+        *out_len = n;
+        if (!n) return (const BYTE *)"";
+        if (!(*alloc = HeapAlloc( GetProcessHeap(), 0, 4 ))) { *out_len = 0; return NULL; }
+        memcpy( *alloc, &data_off, n );
+        return *alloc;
+    }
+    if (!data_len) { *out_len = 0; return (const BYTE *)""; }
+
+    if (!(cell = hive_cell( h, data_off, &clen ))) { *out_len = 0; return NULL; }
+
+    if (data_len > 16344 && clen >= 4 && cell[0] == 'd' && cell[1] == 'b')
+    {
+        DWORD nseg = hive_u16( cell + 2 ), list_off = hive_u32( cell + 4 );
+        const BYTE *list;
+        DWORD list_len, copied = 0, i;
+        BYTE *buf;
+
+        if (!(list = hive_cell( h, list_off, &list_len )) || list_len < nseg * 4) { *out_len = 0; return NULL; }
+        if (!(buf = HeapAlloc( GetProcessHeap(), 0, data_len ))) { *out_len = 0; return NULL; }
+        for (i = 0; i < nseg && copied < data_len; i++)
+        {
+            const BYTE *seg;
+            DWORD seg_len, take;
+            if (!(seg = hive_cell( h, hive_u32( list + i * 4 ), &seg_len ))) break;
+            take = data_len - copied;
+            if (take > 16344) take = 16344;
+            if (take > seg_len) take = seg_len;
+            memcpy( buf + copied, seg, take );
+            copied += take;
+        }
+        *alloc = buf;
+        *out_len = copied;
+        return buf;
+    }
+
+    *out_len = (data_len <= clen) ? data_len : clen;
+    return cell;
+}
+
+/* recreate all values of the nk key whose content is at @nk under @dst */
+static void hive_import_values( const struct hive_buf *h, const BYTE *nk, DWORD nk_len, HKEY dst )
+{
+    DWORD count = hive_u32( nk + 0x24 ), list_off = hive_u32( nk + 0x28 ), i, list_len;
+    const BYTE *list;
+
+    if (nk_len < 0x2c || !count || count == 0xffffffff) return;
+    if (!(list = hive_cell( h, list_off, &list_len )) || list_len < count * 4) return;
+
+    for (i = 0; i < count; i++)
+    {
+        const BYTE *vk;
+        DWORD vk_len, data_len, data_off, out_len;
+        WORD name_len, flags;
+        WCHAR *name;
+        BYTE *alloc;
+        const BYTE *data;
+
+        if (!(vk = hive_cell( h, hive_u32( list + i * 4 ), &vk_len )) || vk_len < 0x14) continue;
+        if (vk[0] != 'v' || vk[1] != 'k') continue;
+        name_len = hive_u16( vk + 2 );
+        data_len = hive_u32( vk + 4 );
+        data_off = hive_u32( vk + 8 );
+        flags    = hive_u16( vk + 0x10 );
+        if (0x14 + name_len > vk_len) continue;
+        name = name_len ? hive_name( vk + 0x14, name_len, flags & 1 ) : NULL;
+        data = hive_value_data( h, data_len, data_off, &alloc, &out_len );
+        if (data)
+            RegSetValueExW( dst, name, 0, hive_u32( vk + 0x0c ), data, out_len );
+        HeapFree( GetProcessHeap(), 0, alloc );
+        HeapFree( GetProcessHeap(), 0, name );
+    }
+}
+
+static void hive_import_key( const struct hive_buf *h, DWORD nk_off, HKEY dst, int depth );
+
+/* walk a subkey list (lf/lh/li/ri) and import each referenced nk under @dst */
+static void hive_import_subkeys( const struct hive_buf *h, DWORD list_off, HKEY dst, int depth )
+{
+    const BYTE *list;
+    DWORD list_len, count, i, stride, entry;
+
+    if (!(list = hive_cell( h, list_off, &list_len )) || list_len < 4) return;
+    count = hive_u16( list + 2 );
+
+    if (list[0] == 'r' && list[1] == 'i')   /* index of subkey lists */
+    {
+        for (i = 0; i < count && 4 + i * 4 + 4 <= list_len; i++)
+            hive_import_subkeys( h, hive_u32( list + 4 + i * 4 ), dst, depth );
+        return;
+    }
+    if (list[0] == 'l' && (list[1] == 'f' || list[1] == 'h')) stride = 8;
+    else if (list[0] == 'l' && list[1] == 'i')                stride = 4;
+    else return;
+
+    for (i = 0; i < count; i++)
+    {
+        entry = 4 + i * stride;
+        if (entry + 4 > list_len) break;
+        hive_import_key( h, hive_u32( list + entry ), dst, depth );
+    }
+}
+
+/* import the nk key at @nk_off: create it under @dst (by its own name) and recurse */
+static void hive_import_key( const struct hive_buf *h, DWORD nk_off, HKEY parent, int depth )
+{
+    const BYTE *nk;
+    DWORD nk_len;
+    WORD flags, name_len;
+    WCHAR *name;
+    HKEY child;
+
+    if (depth > 512) return;
+    if (!(nk = hive_cell( h, nk_off, &nk_len )) || nk_len < 0x4c) return;
+    if (nk[0] != 'n' || nk[1] != 'k') return;
+    flags    = hive_u16( nk + 2 );
+    name_len = hive_u16( nk + 0x48 );
+    if (0x4c + name_len > nk_len) return;
+    if (!(name = hive_name( nk + 0x4c, name_len, flags & 0x20 ))) return;
+
+    if (!RegCreateKeyExW( parent, name, 0, NULL, REG_OPTION_VOLATILE,
+                          KEY_ALL_ACCESS, NULL, &child, NULL ))
+    {
+        hive_import_values( h, nk, nk_len, child );
+        if (hive_u32( nk + 0x14 ) && hive_u32( nk + 0x14 ) != 0xffffffff)
+            hive_import_subkeys( h, hive_u32( nk + 0x1c ), child, depth + 1 );
+        RegCloseKey( child );
+    }
+    HeapFree( GetProcessHeap(), 0, name );
 }
 
