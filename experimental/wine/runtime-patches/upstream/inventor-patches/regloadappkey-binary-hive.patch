+/* return a pointer to the content of the cell at hive-relative offset, and its
+ * usable length; NULL on any out-of-bounds/invalid access */
+static const BYTE *hive_cell( const struct hive_buf *h, DWORD off, DWORD *len )
 {
-    FIXME("%s %p %lu %lu %lu: stub\n", wine_dbgstr_a(file), result, sam, options, reserved);
+    DWORD pos;
+    int cell_size;
+
+    if (off == 0xffffffff) return NULL;
+    pos = HIVE_DATA_OFFSET + off;
+    if (pos + 4 < pos || pos + 4 > h->size) return NULL;
+    memcpy( &cell_size, h->data + pos, 4 );
+    if (cell_size >= 0) return NULL;           /* free cell */
+    cell_size = -cell_size;
+    if ((DWORD)cell_size < 4 || pos + (DWORD)cell_size > h->size) return NULL;
+    if (len) *len = cell_size - 4;
+    return h->data + pos + 4;
+}
 
